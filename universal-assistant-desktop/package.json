    "electron-builder": "^24.13.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.4",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
